{
  "name": "@teamsync/teamsync",
  "version": "0.1.0",
  "description": "Git-based team collaboration CLI for small teams: role-aware branches, PRs, and GitHub-native auto-merge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "teamsync": "bin/teamsync.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "prepack": "npm run build"
  },
  "keywords": [
    "git",
    "github",
    "team",
    "cli",
    "pull-request",
    "auto-merge"
  ],
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
